# Copy this file to .env and replace the placeholder values.

# Absolute path to your Application Default Credentials JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Google Cloud Project ID used with the Google Analytics APIs.
# Find it in Google Cloud Console:
# 1. Open https://console.cloud.google.com/
# 2. Select the project at the top of the page
# 3. Copy the "Project ID" value
#
# Example:
# GOOGLE_PROJECT_ID=my-analytics-prod-123456
#
# This is the GCP Project ID, not your GA account ID or GA property ID.
# The repository docs currently use GOOGLE_PROJECT_ID in examples.
GOOGLE_PROJECT_ID=your-google-cloud-project-id

# Network settings for a future HTTP or proxy deployment.
# Use 0.0.0.0 if you want the streamable HTTP server to listen on all local
# interfaces so other devices on your LAN can reach it.
# Start the HTTP server with:
# /Users/shiwen/.pyenv/versions/codex/bin/python -m analytics_mcp.server_streamable_http
# or the installed script:
# analytics-mcp-http
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PATH=/mcp
SERVER_URL=http://192.168.1.100:8000/mcp
